# SPEC-v2 XM-7: where the share enumeration helper is built and installed.
# The plugin looks for it at the install path (tests point
# NETVFS_SMB_SHARES_HELPER at the build tree's copy).
NETVFS_SMB_SHARES_INSTALL_DIR = /usr/libexec/netvfs
NETVFS_SMB_SHARES_OUT = $$NETVFS_BUILD/libexec/netvfs
