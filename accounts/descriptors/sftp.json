{
    "provider": "sftp",
    "services": ["backup", "files"],
    "defaultPort": 22,
    "authModes": [
        { "id": "password", "label": "settings-accounts-netvfs-me-password", "secret": "password" },
        { "id": "publickey", "source": "generate", "label": "settings-accounts-netvfs-me-key_generate", "secret": "key" },
        { "id": "publickey", "source": "import", "label": "settings-accounts-netvfs-me-key_import", "secret": "key" },
        { "id": "interactive", "label": "settings-accounts-netvfs-me-interactive", "secret": "none" }
    ],
    "fields": [
        { "key": "host", "type": "text", "label": "settings-accounts-netvfs-la-server",
          "placeholder": "settings-accounts-netvfs-ph-server", "validation": "host", "input": "url" },
        { "key": "port", "type": "text", "label": "settings-accounts-netvfs-la-port",
          "validation": "port", "optional": true, "input": "digits" },
        { "key": "username", "type": "text", "label": "settings-accounts-netvfs-la-user", "validation": "userName" },
        { "key": "key_mode_hint", "type": "note", "label": "settings-accounts-netvfs-la-key_mode_hint",
          "visibleWhen": { "auth_mode": ["publickey"] } },
        { "key": "interactive_hint", "type": "note", "label": "settings-accounts-netvfs-la-interactive_hint",
          "visibleWhen": { "auth_mode": ["interactive"] } },
        { "key": "allow_shell", "type": "switch", "label": "settings-accounts-netvfs-la-allow_shell",
          "description": "settings-accounts-netvfs-la-allow_shell_description", "default": false },
        { "key": "backups_path", "type": "text", "label": "settings-accounts-netvfs-la-backups_folder",
          "description": "settings-accounts-netvfs-la-folder_in_home", "default": "Sailfish OS/Backups",
          "validation": "folder", "service": "backup" },
        { "key": "files_root", "type": "text", "label": "settings-accounts-netvfs-la-files_root",
          "description": "settings-accounts-netvfs-la-files_root_home", "validation": "folder", "optional": true,
          "service": "files" }
    ]
}
