<!-- SPEC 6.1: no user-group tag, so the provider is offered to everyone. -->
<!DOCTYPE provider>
<provider version="1.0" id="@PROVIDER@">
    <name>@NAME@</name>
    <description>@DESCRIPTION@</description>
    <icon>image://theme/graphic-service-@PROVIDER@</icon>
</provider>
