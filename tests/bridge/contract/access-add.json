{
    "description": "Add only: folders are listed and new items added; files of others are neither read nor seen (PermissionDenied, detail add)",
    "consent": "add",
    "files": { "in/a.txt": "hello", "in/sub/b.txt": "b" },
    "steps": [
        { "call": "Hello", "sig": "s", "args": ["contract"], "reply": ["*"] },
        { "call": "ListLocations", "sig": "", "args": [],
          "reply": [[["account:1", "fake", "Fake 1", { "access": "add" }]]] },
        { "call": "List", "sig": "saysu", "args": ["account:1", { "bytes": "in" }, "", 0], "reply": ["$req"] },
        { "signal": "ListBatch", "args": ["$req", [[{ "bytes": "sub" }, 2, "..."]]] },
        { "signal": "ListDone", "args": ["$req", "", ""] },
        { "call": "Stat", "sig": "saybs", "args": ["account:1", { "bytes": "in/sub" }, true, ""],
          "reply": [[{ "bytes": "sub" }, 2, "..."]] },
        { "call": "Stat", "sig": "saybs", "args": ["account:1", { "bytes": "in/a.txt" }, true, ""],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "Stat", "sig": "saybs", "args": ["account:1", { "bytes": "in/none" }, true, ""],
          "error": "org.netvfs.Error.NotFound" },
        { "call": "OpenRead", "sig": "says", "args": ["account:1", { "bytes": "in/a.txt" }, ""],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "Checksum", "sig": "says", "args": ["account:1", { "bytes": "in/a.txt" }, "sha256"],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "ReadLink", "sig": "say", "args": ["account:1", { "bytes": "in/a.txt" }],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "ServerCopy", "sig": "sayaya{sv}", "args": ["account:1", { "bytes": "in/a.txt" }, { "bytes": "in/c" }, {}],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "MakeDir", "sig": "sayb", "args": ["account:1", { "bytes": "in/sub/new" }, true], "reply": [] },
        { "call": "Rename", "sig": "sayayb", "args": ["account:1", { "bytes": "in/sub/new" }, { "bytes": "in/sub/n" }, false],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "RemoveFile", "sig": "say", "args": ["account:1", { "bytes": "in/a.txt" }],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "RemoveFile", "sig": "say", "args": ["account:1", { "bytes": "in/gone" }],
          "error": "org.netvfs.Error.NotFound" },
        { "call": "Stat", "sig": "saybs", "args": ["account:1", { "bytes": "in/sub/new" }, true, ""],
          "reply": [[{ "bytes": "new" }, 2, "..."]] }
    ]
}
