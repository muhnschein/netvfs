{
    "description": "Read and add: new items can be added; what the app added stays its own until renamed or removed; what others put there is never changed (PermissionDenied, detail read-add)",
    "consent": "read-add",
    "files": { "docs/a.txt": "hello" },
    "steps": [
        { "call": "Hello", "sig": "s", "args": ["contract"], "reply": ["*"] },
        { "call": "ListLocations", "sig": "", "args": [],
          "reply": [[["account:1", "fake", "Fake 1", { "access": "read-add" }]]] },
        { "call": "MakeDir", "sig": "sayb", "args": ["account:1", { "bytes": "docs/new" }, true], "reply": [] },
        { "call": "RemoveDir", "sig": "say", "args": ["account:1", { "bytes": "docs/new" }],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "ServerCopy", "sig": "sayaya{sv}", "args": ["account:1", { "bytes": "docs/a.txt" }, { "bytes": "docs/.t.part" }, {}],
          "reply": [] },
        { "call": "SetAttributes", "sig": "saya{sv}", "args": ["account:1", { "bytes": "docs/.t.part" }, { "mtimeMs": 5000 }],
          "reply": [] },
        { "call": "Rename", "sig": "sayayb", "args": ["account:1", { "bytes": "docs/.t.part" }, { "bytes": "docs/a.txt" }, true],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "Rename", "sig": "sayayb", "args": ["account:1", { "bytes": "docs/.t.part" }, { "bytes": "docs/a.txt" }, false],
          "error": "org.netvfs.Error.AlreadyExists" },
        { "call": "Rename", "sig": "sayayb", "args": ["account:1", { "bytes": "docs/.t.part" }, { "bytes": "docs/t.txt" }, false],
          "reply": [] },
        { "call": "RemoveFile", "sig": "say", "args": ["account:1", { "bytes": "docs/t.txt" }],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "RemoveFile", "sig": "say", "args": ["account:1", { "bytes": "docs/a.txt" }],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "RemoveFile", "sig": "say", "args": ["account:1", { "bytes": "docs/.gone.part" }],
          "error": "org.netvfs.Error.NotFound" },
        { "call": "ServerCopy", "sig": "sayaya{sv}", "args": ["account:1", { "bytes": "docs/a.txt" }, { "bytes": "docs/a2.txt" }, {}],
          "reply": [] },
        { "call": "RemoveFile", "sig": "say", "args": ["account:1", { "bytes": "docs/a2.txt" }], "reply": [] },
        { "call": "ServerCopy", "sig": "sayaya{sv}", "args": ["account:1", { "bytes": "docs/a.txt" }, { "bytes": "docs/t.txt" }, { "replace": true }],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "RemoveTree", "sig": "say", "args": ["account:1", { "bytes": "docs/new" }],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "MakeHardlink", "sig": "sayay", "args": ["account:1", { "bytes": "docs/a.txt" }, { "bytes": "docs/h" }],
          "error": "org.netvfs.Error.PermissionDenied" },
        { "call": "Checksum", "sig": "says", "args": ["account:1", { "bytes": "docs/t.txt" }, "sha256"], "reply": ["*"] }
    ]
}
