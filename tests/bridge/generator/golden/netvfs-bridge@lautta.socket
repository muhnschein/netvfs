# Generated by netvfs-bridge-generator from lautta.conf
[Unit]
Description=netvfs bridge rendezvous for Lautta
ConditionPathIsDirectory=%h/.local/share/org.netvfs/lautta

[Socket]
ListenStream=%h/.local/share/org.netvfs/lautta/netvfs/bridge.sock
SocketMode=0600
DirectoryMode=0700
Accept=no
RemoveOnStop=yes
