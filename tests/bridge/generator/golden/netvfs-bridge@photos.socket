# Generated by netvfs-bridge-generator from photos.conf
[Unit]
Description=netvfs bridge rendezvous for Photo 100%% Sync
ConditionPathIsDirectory=%h/.local/share/harbour-photos/harbour-photos

[Socket]
ListenStream=%h/.local/share/harbour-photos/harbour-photos/netvfs/bridge.sock
SocketMode=0600
DirectoryMode=0700
Accept=no
RemoveOnStop=yes
