# SPDX-License-Identifier: LGPL-2.1-or-later
# UndefinedBehaviorSanitizer reports in the vendored libsmb2 (pin e80c1a48)
# that the SMB interop suite triggers. Reviewed: none of them reads or
# writes out of bounds, and each is a one-line fix upstream. They are listed
# here so that run.sh can make every OTHER report fatal (halt_on_error=1).
# Gate G-SMB item 3 ("runs clean") holds only with these exceptions; remove
# each line once a libsmb2 bump contains the fix.
#
# lib/ntlmssp.c encoder(): memcpy(buf, NULL, 0) on the first allocation.
nonnull-attribute:*/libsmb2/lib/ntlmssp.c
# lib/smb3-seal.c smb3_encrypt_pdu(): 64-bit store of the session id at
# offset 44 of the transform header through a uint64_t pointer.
alignment:*/libsmb2/lib/smb3-seal.c
# lib/unicode.c l1(): left shift of a negative (signed) char while counting
# the leading 1 bits of a UTF-8 lead byte; char is unsigned on aarch64.
shift-base:*/libsmb2/lib/unicode.c
