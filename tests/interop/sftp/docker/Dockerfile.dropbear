# SPDX-License-Identifier: LGPL-2.1-or-later
# Dropbear of a distribution release (ubuntu:26.04 → 2025.89, ubuntu:24.04
# → 2022.83) with OpenSSH's sftp-server as its SFTP subsystem: Dropbear
# has no SFTP server of its own.
ARG BASE=mirror.gcr.io/library/ubuntu:26.04
FROM ${BASE}
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       dropbear-bin openssh-sftp-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/dropbear \
    && dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key \
    && dropbearkey -t ecdsa -s 256 -f /etc/dropbear/dropbear_ecdsa_host_key \
    && dropbearkey -t rsa -s 3072 -f /etc/dropbear/dropbear_rsa_host_key
COPY start-dropbear.sh /setup/
CMD ["/setup/start-dropbear.sh"]
