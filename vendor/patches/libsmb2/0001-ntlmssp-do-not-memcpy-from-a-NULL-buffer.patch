From 0a18240a71e1429bfdd40a70ab8b5bc9e4c6d38d Mon Sep 17 00:00:00 2001
From: muhnschein <tan_anemone.0l@icloud.com>
Date: Fri, 2 Oct 2026 13:18:38 +0000
Subject: [PATCH 1/3] ntlmssp: do not memcpy from a NULL buffer

encoder() grows auth_data->buf by allocating a new buffer and copying
the old contents. On the first call the old buffer is NULL and the
length is 0; memcpy() with a NULL source is undefined behaviour even
for a zero length (UBSan: nonnull-attribute). Only copy when there is
something to copy.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/ntlmssp.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/lib/ntlmssp.c b/lib/ntlmssp.c
index 7c29f9d..87196d9 100644
--- a/lib/ntlmssp.c
+++ b/lib/ntlmssp.c
@@ -257,7 +257,9 @@ encoder(const void *buffer, size_t size, void *ptr)
                         free(tmp);
                         return -1;
                 }
-                memcpy(auth_data->buf, tmp, auth_data->len);
+                if (auth_data->len > 0) {
+                        memcpy(auth_data->buf, tmp, auth_data->len);
+                }
                 free(tmp);
         }
 
